# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fireons_development

# Authentication
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Statement ingestion (LLM-based extraction)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Nightly exchange rate sync
EXCHANGE_RATE_SYNC_ENABLED=true
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/{base}
EXCHANGE_RATE_BASE_CURRENCY=USD
EXCHANGE_RATE_QUOTE_CURRENCY=INR
EXCHANGE_RATE_SYNC_HOUR_UTC=20
EXCHANGE_RATE_SYNC_MINUTE_UTC=30

# Deployment settings (optional, defaults shown; see CLAUDE.md)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3020
# ORIGIN_VERIFY_SECRET=
# INGESTION_TEST_ENABLED=true
# API_DOCS_ENABLED=true
# DATABASE_URL=
# DB_NULL_POOL=false
# DB_CREATE_TABLES_ON_STARTUP=true
# SSM_PREFIX=
