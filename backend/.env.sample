# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fireons_development

# Authentication
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Statement ingestion (LLM-based extraction)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Registry scraper (optional)
# SCRAPE_MIN_INTERVAL_SECONDS=3.0
# SCRAPE_MAX_RETRIES=4
# SCRAPE_SCHEDULE_CRON=0 3 * * sun
# SCRAPE_SCHEDULE_TIMEZONE=Asia/Kolkata
