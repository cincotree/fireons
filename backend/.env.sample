# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fireons_development

# Authentication
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Statement ingestion (LLM-based extraction)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Nightly exchange rate sync
EXCHANGE_RATE_SYNC_ENABLED=true
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/{base}
EXCHANGE_RATE_BASE_CURRENCY=USD
EXCHANGE_RATE_QUOTE_CURRENCY=INR
EXCHANGE_RATE_SYNC_HOUR_UTC=20
EXCHANGE_RATE_SYNC_MINUTE_UTC=30

# Registry scraper (optional)
# SCRAPE_MIN_INTERVAL_SECONDS=3.0
# SCRAPE_MAX_RETRIES=4
# SCRAPE_SCHEDULE_CRON=0 3 * * sun
# SCRAPE_SCHEDULE_TIMEZONE=Asia/Kolkata

# Public API (optional)
# PUBLIC_READ_LIMIT_PER_MINUTE=240
